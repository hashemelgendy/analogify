# --- App environment ---
# "staging" | "production" — rate limits apply only in production.
# If unset, defaults to production behavior (safe for deploys).
# APP_ENV=staging
# APP_ENV=production

# OpenAI (server-side only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=sk-proj-your-key-here

# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Supabase (public project URL + anon key only on the client)
# Copy to .env.local and fill in values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only — bypasses RLS for persistence)
# Never prefix with NEXT_PUBLIC_ and never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (configured in Supabase Dashboard → Authentication → Providers)
# 1. Enable Google provider and add Client ID / Secret from Google Cloud Console
# 2. Redirect URLs (Site URL + Additional Redirect URLs):
#    http://localhost:3000/auth/callback
#    https://YOUR_DOMAIN/auth/callback
# Client uses supabase.auth.signInWithOAuth({ provider: "google" })

# --- /api/explain rate limiting (server-only; production only) ---
# Default: 10 requests per guest (or IP fallback) per rolling hour
# RATE_LIMIT_EXPLAIN_MAX=10
# RATE_LIMIT_EXPLAIN_WINDOW_SECONDS=3600

# Optional Upstash Redis for multi-instance deploys (Vercel).
# Without these, an in-memory sliding window is used (MVP / single instance).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
