# OpenAI (server-side only — never prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=sk-proj-your-key-here

# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Supabase (public project URL + anon key only on the client)
# Copy to .env.local and fill in values from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (server-only — bypasses RLS for persistence)
# Never prefix with NEXT_PUBLIC_ and never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- /api/explain rate limiting (server-only) ---
# Max requests per IP within the window (defaults: 10 per 60s)
# RATE_LIMIT_EXPLAIN_MAX=10
# RATE_LIMIT_EXPLAIN_WINDOW_SECONDS=60

# Upstash Redis (recommended on Vercel for multi-instance limits)
# Create a free Redis DB at https://console.upstash.com and paste REST credentials.
# Without these, an in-memory limiter is used (fine for local; not shared across cold starts).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
